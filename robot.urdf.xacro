<?xml version="1.0"?>
<robot name="robot_guide"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="body_length" value="0.45"/>
  <xacro:property name="body_width" value="0.30"/>
  <xacro:property name="body_height" value="0.14"/>

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.05"/>

  <link name="base_link">

    <visual>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.4 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="5.0"/>
      <inertia
        ixx="0.045667"
        ixy="0.0"
        ixz="0.0"
        iyy="0.092542"
        iyz="0.0"
        izz="0.121875"/>
    </inertial>

  </link>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">

      <visual>
        <origin rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}"
                    length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>

      <collision>
        <origin rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}"
                    length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.5"/>
        <inertia
          ixx="0.001354"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0025"
          iyz="0.0"
          izz="0.001354"/>
      </inertial>

    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y} -0.06"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel side="left" y="0.18"/>
  <xacro:wheel side="right" y="-0.18"/>

  <xacro:macro name="support" params="side x">
    <link name="${side}_support">
      <visual>
        <geometry>
          <sphere radius="0.06"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <sphere radius="0.06"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.2"/>
        <inertia
          ixx="0.000288"
          ixy="0.0"
          ixz="0.0"
          iyy="0.000288"
          iyz="0.0"
          izz="0.000288"/>
      </inertial>
    </link>
    <joint name="${side}_support_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_support"/>
      <origin xyz="${x} 0 -0.10"/>
    </joint>
  </xacro:macro>

  <!-- две опоры удерживают корпус при разгоне и торможении -->
  <xacro:support side="rear" x="-0.17"/>
  <xacro:support side="front" x="0.17"/>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.06"/>
      </geometry>
      <material name="lidar_gray">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.045" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia
        ixx="0.0001605" ixy="0" ixz="0"
        iyy="0.0001605" iyz="0"
        izz="0.0002025"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.13"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar_3d" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>/lidar/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>

      <lidar>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>

          <vertical>
            <samples>8</samples>
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>

        <range>
          <min>0.15</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.03"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <inertial>
      <mass value="0.05"/>
      <inertia
        ixx="0.00001" ixy="0" ixz="0"
        iyy="0.00001" iyz="0"
        izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="-0.245 0 0.15"
            rpy="0 -0.17453292519943295 3.141592653589793"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>

      <camera>
        <horizontal_fov>1.832595714594046</horizontal_fov>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <optical_frame_id>camera_optical_frame</optical_frame_id>

        <image>
          <width>480</width>
          <height>360</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.36</wheel_separation>
      <wheel_radius>0.10</wheel_radius>

      <topic>/model/fun_robot/cmd_vel</topic>
    </plugin>
  </gazebo>

</robot>

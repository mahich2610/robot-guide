<?xml version="1.0"?>
<sdf version="1.9">
  <model name="human_static">
    <static>true</static>

    <pose>0 0 0 0 0 0</pose>

    <link name="body">

      <visual name="human_visual">
        <pose>0 0 0.02 0.04 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/standing.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="human_collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>1.7</length>
          </cylinder>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
